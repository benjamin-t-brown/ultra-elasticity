{
  "configurations": [
    {
      "name": "windows-gcc-x64",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "defines": [
        "_DEBUG",
        "UNICODE",
        "_UNICODE",
        "__LITTLE_ENDIAN__",
        "NET_ENABLE_ENET"
      ],
      "cStandard": "${default}",
      "cppStandard": "${default}",
      "intelliSenseMode": "windows-gcc-x64",
      "compilerArgs": [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-std=c++",
        "-Werror",
        "-O0",
        "-I ./src"
      ],
      "compilerPath": "gcc"
    }
  ],
  "version": 4
}