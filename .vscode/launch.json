{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\src\\ULTRAELASTICITY",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}\\src",
      "environment": [
        {
          "name": "PATH",
          "value": "${config:cppdbg.msys2BinPath};${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${config:cppdbg.miDebuggerPath}",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Break on bad optional access",
          "text": "catch throw std::bad_optional_access",
          "ignoreFailures": false
        }
      ]
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/progs/regem-ludos/iframes/games/elasticity/src/game/actions/spawn",
      "program": "c:/progs/regem-ludos/iframes/games/elasticity/src/game/actions/spawn/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}